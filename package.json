{
  "name": "festivalapp",
  "version": "0.1.0",
  "private": true,
  "description": "Progressive Web App voor festivalbezoekers — STA-NL07 Groep 1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "app",
    "backend",
    "portal"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,app,portal -c blue,magenta,cyan \"npm run dev -w backend\" \"npm run dev -w app\" \"npm run dev -w portal\"",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "gen:api": "openapi-typescript backend/api.yaml -o app/src/api/schema.d.ts && openapi-typescript backend/api.yaml -o portal/src/api/schema.d.ts",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
