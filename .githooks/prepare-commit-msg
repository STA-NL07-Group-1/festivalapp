#!/bin/sh
# Voegt automatisch "Signed-off-by: Naam <e-mail>" toe (DCO).
COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Niet bij merges en squashes
case "$COMMIT_SOURCE" in merge|squash) exit 0 ;; esac

NAME=$(git config user.name)
EMAIL=$(git config user.email)
[ -z "$NAME" ] || [ -z "$EMAIL" ] && exit 0

SOB="Signed-off-by: $NAME <$EMAIL>"
grep -qs "^$SOB" "$COMMIT_MSG_FILE" || git interpret-trailers --in-place --trailer "$SOB" "$COMMIT_MSG_FILE"
