#!/bin/sh
# Blokkeert commits met geheimen (wachtwoorden, API-sleutels, tokens).
# Wordt aangezet door `npm install` (git config core.hooksPath .githooks).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner || {
    echo ""
    echo "✋ Gitleaks heeft een mogelijk geheim gevonden. Haal het uit je commit."
    echo "   Vals alarm? Zet 'gitleaks:allow' als commentaar op die regel."
    exit 1
  }
else
  echo "ℹ️  Gitleaks is niet geïnstalleerd; geheimen-check overgeslagen (CI controleert wel)."
  echo "   Installeren: https://github.com/gitleaks/gitleaks#installing"
fi

# Nooit .env-bestanden committen
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "✋ Je probeert een .env-bestand te committen. Dat mag niet."
  exit 1
fi
