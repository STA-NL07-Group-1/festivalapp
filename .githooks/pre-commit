#!/bin/sh
# Controleert vóór elke commit of er wachtwoorden, keys of tokens in je wijzigingen staan.
# Eenmalig aanzetten per computer:  git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo ""
  echo "  Gitleaks is niet geinstalleerd, dus je commit is niet gecontroleerd op secrets."
  echo "  Installeer het eenmalig:"
  echo "    Windows:  winget install Gitleaks.Gitleaks   (daarna terminal herstarten)"
  echo "    Mac:      brew install gitleaks"
  echo ""
  exit 1
fi

gitleaks git --pre-commit --staged --redact --verbose
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "  Commit geblokkeerd: er lijkt een secret in je wijzigingen te staan."
  echo "  Haal het weg, zet het in .env en probeer opnieuw."
  echo ""
fi

exit $status