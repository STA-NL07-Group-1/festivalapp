# Kopieer op de VPS naar .env.production (staat in .gitignore) en vul in.

# Het adres van de app, zonder https://
DOMAIN=festivalbuddy.nl

# Token van de Cloudflare Tunnel (Zero Trust → Networks → Tunnels → festivalapp)
CLOUDFLARE_TUNNEL_TOKEN=

# Database-wachtwoord (alleen letters/cijfers, want het komt in een URL):  openssl rand -hex 32
POSTGRES_PASSWORD=

# Inlog-tokens ondertekenen:  openssl rand -base64 48
JWT_SECRET=

FESTIVAL_TIME_ZONE=Europe/Amsterdam

# Pushmeldingen. Genereer met:
#   sudo docker compose -f compose.prod.yaml --env-file .env.production run --rm --no-deps backend npx web-push generate-vapid-keys
# Maak ze één keer aan en verander ze daarna niet, anders werken bestaande meldingen niet meer.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Een adres dat iemand leest (bijv. je Fontys-mail); pushdiensten mailen hierheen bij problemen.
VAPID_SUBJECT=mailto:jij@example.com

# Kaart (publiek, komt in de browser). Voeg in CARTO festivalbuddy.nl toe als website-beperking.
VITE_CARTO_KEY=

# Sensoren: apparaat-id:sha256-van-de-sleutel, kommagescheiden (optioneel)
IOT_DEVICE_KEYS=

# Mail via Resend: welkom, e-mailadres bevestigen en wachtwoord vergeten.
# Sleutel met alleen verzendrechten (Resend → API Keys → Sending access).
# Het domein van MAIL_FROM moet in Resend geverifieerd zijn. Zonder sleutel komen mails alleen in de log.
RESEND_API_KEY=
MAIL_FROM=Festival Buddy <no-reply@festivalbuddy.nl>
# Hier komt de mail heen als de site plat ligt (zie "Controleren of de site werkt" in deploy/README.md)
ALERT_EMAIL=

# AI-chatbot (optioneel)
AI_API_KEY=
AI_MODEL=
