# Kopieer op de VPS naar .env.production (staat in .gitignore) en vul in.

# Het adres van de app, zonder https://
DOMAIN=festivalapp.nulllabx.com

# Token van de Cloudflare Tunnel (Zero Trust → Networks → Tunnels → festivalapp)
CLOUDFLARE_TUNNEL_TOKEN=

# Database-wachtwoord:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Inlog-tokens ondertekenen:  openssl rand -base64 48
JWT_SECRET=

FESTIVAL_TIME_ZONE=Europe/Amsterdam

# Pushmeldingen. Genereer met:
#   docker compose -f compose.prod.yaml run --rm --no-deps backend npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@example.com

# Kaart (publiek, komt in de browser). Voeg in CARTO festivalapp.nulllabx.com toe als website-beperking.
VITE_CARTO_KEY=

# Sensoren: apparaat-id:sha256-van-de-sleutel, kommagescheiden (optioneel)
IOT_DEVICE_KEYS=

# AI-chatbot (optioneel)
AI_API_KEY=
AI_MODEL=
