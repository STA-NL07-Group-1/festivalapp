# Webserver in de container. HTTPS regelt Cloudflare (en eventueel je bestaande proxy);
# deze Caddy luistert alleen op HTTP binnen de server.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# Beveiligingsheaders voor alle pagina's
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self' wss://{host} https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API en WebSocket → backend (zonder het /api-voorvoegsel)
	handle_path /api/* {
		reverse_proxy backend:3000
	}

	# Beheerportal
	redir /beheer /beheer/ 308
	handle_path /beheer/* {
		root * /srv/portal
		header X-Robots-Tag "noindex, nofollow"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	# De app (PWA)
	handle {
		root * /srv/app
		# Service worker en index.html nooit lang cachen, anders komen updates niet aan
		@nocache path /sw.js /index.html / /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
