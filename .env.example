# Kopieer naar .env (staat in .gitignore) en vul in. Zet hier NOOIT echte geheimen in Git.

NODE_ENV=development
PORT=3000

# PostgreSQL (zie compose.yaml)
DATABASE_URL=postgres://festivalapp:festivalapp@localhost:5432/festivalapp
TEST_DATABASE_URL=postgres://festivalapp:festivalapp@localhost:5432/festivalapp_test

# Minstens 32 willekeurige tekens. Genereer met: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Waar draaien app en portal? (CORS + link in de QR-code)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
APP_URL=http://localhost:5173
FESTIVAL_TIME_ZONE=Europe/Amsterdam
# Zet op 1 als de backend achter een reverse proxy/load balancer draait
TRUST_PROXY=0

# Web Push — genereer met: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.org

# Sensoren: apparaat-id:sha256-van-de-sleutel, kommagescheiden
# Hash maken: node -e "console.log(require('crypto').createHash('sha256').update('JOUW-SLEUTEL').digest('hex'))"
IOT_DEVICE_KEYS=

# Mail via Resend (optioneel; zonder sleutel komen mails alleen in de log van de backend)
# Sleutel met alleen verzendrechten; het domein moet in Resend geverifieerd zijn.
RESEND_API_KEY=
MAIL_FROM=Festival Buddy <no-reply@festivalbuddy.nl>

# AI-chatbot (optioneel; zonder sleutel gebruikt de chatbot de ingebouwde FAQ)
AI_API_KEY=
AI_MODEL=
