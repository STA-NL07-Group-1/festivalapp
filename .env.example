# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Zet NOOIT echte waarden in dit bestand of in de repo.

# --- Algemeen ---
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=

# --- Authenticatie ---
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=

# --- Pushmeldingen (Web Push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Foto-opslag ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/callback/spotify

# --- AI-chatbot ---
AI_API_KEY=

# --- Liedje herkennen ---
SONG_RECOGNITION_API_KEY=

# --- Kaart ---
MAP_API_KEY=