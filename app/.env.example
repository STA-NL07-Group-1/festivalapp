# Kopieer naar app/.env.local en pas aan. Alleen variabelen met het
# voorvoegsel VITE_ komen in de app terecht — zet hier dus NOOIT geheimen.

# Basis-URL van de backend-API (lokaal: de backend)
VITE_API_URL=http://localhost:3000

# Optioneel: gratis CARTO-sleutel voor de mooie donkere/lichte kaart (https://carto.com/basemaps/apikey).
# Zonder sleutel gebruikt de app OpenStreetMap. Deze sleutel is zichtbaar in de browser:
# stel in CARTO een website-beperking in op jullie domein.
VITE_CARTO_KEY=
