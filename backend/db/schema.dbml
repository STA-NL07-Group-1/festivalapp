// Festivalapp — databasediagram
// Plak dit bestand in https://dbdiagram.io om het diagram te zien.
// Bron van waarheid zijn de bestanden in migrations/; houd dit bestand daarmee gelijk.

Project festivalapp {
  database_type: 'PostgreSQL'
  Note: 'Meerdere festivals in één installatie (migratie 0004). Geheimen alleen als hash. Alleen de laatste locatie per gebruiker.'
}

Enum platform_role {
  eigenaar [note: 'Mag bij elk festival, met de rechten van een beheerder']
  sudo [note: 'Zoals eigenaar, en de enige die eigenaren en beheerders aanwijst. Hoogstens één account.']
}

Enum festival_role {
  beheerder
  organisatie
  ehbo
  beveiliging
}

Enum lost_item_status {
  gevonden
  opgehaald
}

Enum app_theme {
  systeem
  licht
  donker
}

Enum app_locale {
  nl
  en
}

Enum email_token_purpose {
  verify
  reset
}

Enum ticket_status {
  geldig
  gekoppeld
  ingetrokken
}

Enum pin_visibility {
  prive
  vrienden
}

Enum performance_status {
  gepland
  vertraagd
  verplaatst
  geannuleerd
}

Enum announcement_level {
  info
  waarschuwing
  nood
}

Enum sos_status {
  open
  in_behandeling
  afgehandeld
}

Enum crowd_level {
  rustig
  gemiddeld
  druk
  vol
}

Enum map_point_kind {
  wifi
  ehbo
  water
  toilet
  ingang
  uitgang
  eten
  activiteit
  oplaadpunt
  info
}

TableGroup accounts {
  tickets
  users
  sessions
}

TableGroup festivals_en_rollen {
  festivals
  festival_members
  festival_blocks
}

TableGroup festivalinformatie {
  faq_items
  site_maps
  lost_items
}

TableGroup sociaal {
  friend_codes
  friendships
  locations
  pins
  messages
}

TableGroup programma {
  stages
  performances
  timetable_entries
  show_signups
  crowd_readings
}

TableGroup organisatie {
  push_subscriptions
  announcements
  sos_alerts
  audit_log
}

Table festivals {
  id uuid [pk, default: `gen_random_uuid()`]
  name text [not null, note: '1–80 tekens']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null, note: 'na starts_at; daarna verliezen bezoekers de toegang']
  house_rules_nl text [note: 'max. 5000 tekens (migratie 0005)']
  house_rules_en text [note: 'max. 5000 tekens']
  created_at timestamptz [not null, default: `now()`]
}

Table faq_items {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  question_nl text [not null, note: '1–200 tekens']
  question_en text [not null, note: '1–200 tekens']
  answer_nl text [not null, note: '1–2000 tekens']
  answer_en text [not null, note: '1–2000 tekens']
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Veelgestelde vragen per festival. Ook gebruikt door de festivalassistent.'
}

Table site_maps {
  festival_id uuid [pk, ref: - festivals.id]
  content_type text [not null, note: 'image/png, image/jpeg of image/webp']
  data bytea [not null, note: 'max. 3 MB']
  updated_by uuid [ref: > users.id]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Plattegrond van het festival zelf'
}

Table lost_items {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  description text [not null, note: '1–200 tekens, geen persoonsgegevens']
  found_where text [note: 'max. 100 tekens']
  found_at timestamptz [not null, default: `now()`]
  status lost_item_status [not null, default: 'gevonden']
  collected_at timestamptz [note: 'gevuld als status = opgehaald']
  created_by uuid [ref: > users.id]
}

Table festival_members {
  festival_id uuid [pk, ref: > festivals.id]
  user_id uuid [pk, ref: > users.id]
  role festival_role [not null]
  added_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Personeel van een festival. Wie hier niet in staat en een ticket heeft, is bezoeker.'
}

Table festival_blocks {
  festival_id uuid [pk, ref: > festivals.id]
  user_id uuid [pk, ref: > users.id]
  reason text [not null, note: '1–200 tekens']
  blocked_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Bezoeker geblokkeerd voor één festival. Voor alle festivals: users.blocked_at.'
}

Table tickets {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  user_id uuid [ref: > users.id, note: 'Wie het ticket heeft gekoppeld. Hoogstens één ticket per account per festival.']
  code_hash text [not null, unique, note: 'SHA-256 van de ticketcode']
  ticket_type text [not null, default: 'weekend']
  valid_from timestamptz [not null]
  valid_until timestamptz [not null]
  status ticket_status [not null, default: 'geldig']
  created_at timestamptz [not null, default: `now()`]
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [not null, unique]
  password_hash text [not null, note: 'argon2id']
  display_name text [not null, note: '1–40 tekens']
  platform_role platform_role [note: 'Leeg voor gewone accounts']
  theme app_theme [not null, default: 'systeem']
  locale app_locale [not null, default: 'nl']
  share_location boolean [not null, default: false]
  share_timetable boolean [not null, default: false]
  failed_logins integer [not null, default: 0]
  locked_until timestamptz
  blocked_at timestamptz [note: 'Geblokkeerd voor alle festivals (migratie 0003)']
  blocked_reason text [note: 'Korte neutrale reden, max. 200 tekens']
  email_verified_at timestamptz [note: 'Leeg = e-mailadres nog niet bevestigd (migratie 0006)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table email_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  purpose email_token_purpose [not null]
  token_hash text [not null, unique, note: 'SHA-256 van de token uit de mail']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'reset max. 1 uur, verify max. 2 dagen']
  used_at timestamptz [note: 'Gevuld = al gebruikt']
}

Table sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  refresh_token_hash text [not null, unique]
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz
}

Table friend_codes {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  code_hash text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'max. 15 minuten na created_at']
  used_at timestamptz
  used_by uuid [ref: > users.id]
}

Table friendships {
  user_a uuid [not null, ref: > users.id]
  user_b uuid [not null, ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_a, user_b) [pk]
  }
  Note: 'user_a < user_b: één rij per vriendenpaar'
}

Table locations {
  user_id uuid [pk, ref: - users.id]
  festival_id uuid [not null, ref: > festivals.id]
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  accuracy_m real
  recorded_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, note: 'max. 1 uur na recorded_at']
}

Table pins {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  festival_id uuid [not null, ref: > festivals.id]
  label text [not null]
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  visibility pin_visibility [not null, default: 'vrienden']
  created_at timestamptz [not null, default: `now()`]
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  sender_id uuid [not null, ref: > users.id]
  recipient_id uuid [not null, ref: > users.id]
  body text [not null, note: '1–1000 tekens']
  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz
}

Table stages {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  name text [not null, note: 'uniek binnen het festival']
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  capacity integer [not null]
  sort_order integer [not null, default: 0]

  indexes {
    (festival_id, name) [unique]
  }
}

Table performances {
  id uuid [pk, default: `gen_random_uuid()`]
  stage_id uuid [not null, ref: > stages.id]
  artist text [not null]
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status performance_status [not null, default: 'gepland']
  signup_capacity integer [note: 'NULL = geen aanmelding nodig']
  updated_at timestamptz [not null, default: `now()`]
}

Table timetable_entries {
  user_id uuid [not null, ref: > users.id]
  performance_id uuid [not null, ref: > performances.id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, performance_id) [pk]
  }
}

Table show_signups {
  user_id uuid [not null, ref: > users.id]
  performance_id uuid [not null, ref: > performances.id]
  created_at timestamptz [not null, default: `now()`]
  checked_in_at timestamptz
  indexes {
    (user_id, performance_id) [pk]
  }
}

Table crowd_readings {
  id bigint [pk, increment]
  stage_id uuid [not null, ref: > stages.id]
  device_id text [not null]
  head_count integer [not null]
  level crowd_level [not null]
  measured_at timestamptz [not null, default: `now()`]
}

Table push_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  endpoint text [not null, unique, note: 'alleen https']
  p256dh text [not null]
  auth text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table announcements {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  author_id uuid [ref: > users.id]
  level announcement_level [not null, default: 'info']
  title_nl text [not null]
  title_en text [not null]
  body_nl text [not null]
  body_en text [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
}

Table sos_alerts {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  user_id uuid [ref: > users.id]
  latitude "double precision"
  longitude "double precision"
  message text
  status sos_status [not null, default: 'open']
  handled_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
}

Table audit_log {
  id bigint [pk, increment]
  actor_id uuid [note: 'geen FK: blijft staan na accountverwijdering']
  action text [not null, note: 'formaat: domein.actie']
  target_type text
  target_id text
  details jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Append-only: UPDATE en DELETE worden door een trigger geweigerd'
}

Table map_points {
  id uuid [pk, default: `gen_random_uuid()`]
  festival_id uuid [not null, ref: > festivals.id]
  kind map_point_kind [not null]
  name text [not null, note: '1–60 tekens']
  description text [note: 'max. 200 tekens']
  latitude "double precision" [not null]
  longitude "double precision" [not null]
  created_by uuid [ref: > users.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Kaartpunten van de organisatie (wifi, EHBO, water, ingang, oplaadpunten). Migratie 0002.'
}
